  m_Script: {fileID: 11500000, guid: 02fd617bcf3e6174fac4f95d3839e4aa, type: 3}
  m_Name: 00 Changelog
  m_EditorClassIdentifier: 
  guideTitle: Changelog
  pages:
  - pageSprite: {fileID: 21300000, guid: 4342eb5d762203341abe650bf1c7f224, type: 3}
    descriptionText: "Nesta entrega implementamos o sistema de habilidades e build,
      agora \xE9 poss\xEDvel selecionar quais skills equipar, filtrando por categorias,
      e levar para as lutas. Tamb\xE9m atualizamos o sistema de mira para as habilidades
      e implementamos mais feedbacks, principalmente atrav\xE9s de VFX."
  - pageSprite: {fileID: 0}
    descriptionText: "Al\xE9m disso refizemos a estrutura das duas lutas, alterando
      como os chefes se comportam: \n- Hocari: Altera\xE7\xE3o dos golpes e da reestrutura\xE7\xE3o
      de quando cada golpe pode acontecer;\n- Laki: Balanceamento das casas da roleta,
      adi\xE7\xE3o de golpes novos e limita\xE7\xE3o da \xE1rea da arena."
